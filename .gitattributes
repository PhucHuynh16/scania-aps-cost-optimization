# Markdown uses trailing spaces for intentional hard line breaks.
*.md whitespace=-blank-at-eol

# Binary deliverables
*.pdf binary
*.docx binary
*.pptx binary
*.png binary

# Dataset and preprocessing artifacts (preserve exact raw bytes and SHA-256 checksums)
data/raw/** binary
data/processed/** binary
*.npy binary
*.npz binary
*.joblib binary
*.zip binary
