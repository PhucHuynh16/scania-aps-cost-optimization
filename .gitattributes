# Markdown uses trailing spaces for intentional hard line breaks.
*.md whitespace=-blank-at-eol

# Binary deliverables
*.pdf binary
*.docx binary
*.pptx binary
*.png binary

# Dataset and preprocessing artifacts (preserve exact raw bytes and SHA-256 checksums)
data/raw/** binary
data/processed/** binary
*.npy binary
*.npz binary
*.joblib binary
*.zip binary

# Preserve the byte-level digests of supplemental runs and the demo sample.
results/scania_aps/rf_supplement/** -text whitespace=cr-at-eol
data/examples/** -text whitespace=cr-at-eol
configs/scania/rf_supplement.json text eol=lf
scripts/run_scania_rf_supplement.py text eol=lf
